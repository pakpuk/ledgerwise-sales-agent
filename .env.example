# --- Required ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require   # Neon
APP_PASSWORD=change-me                                       # shared team login
SESSION_SECRET=at-least-16-random-chars

# --- LLM (one of the two; LLM_PROVIDER picks if both are set) ---
LLM_PROVIDER=anthropic          # anthropic | gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MODEL_FAST=claude-haiku-5-5     # classification, fact extraction
MODEL_SMART=claude-opus-5-5     # qualify, write, reply

# --- Optional (graceful fallback if missing) ---
TAVILY_API_KEY=                 # npm run research discovery
CAL_API_KEY=                    # real calendar; otherwise simulated DB slots
CAL_EVENT_TYPE_ID=
CAL_BOOKING_EMAIL=               # real inbox Cal.com books with (sandbox prospect emails are rejected)
